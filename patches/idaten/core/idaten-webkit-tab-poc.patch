+// A WebKit tab is an ordinary Chromium tab whose (placeholder) WebContents has
+// committed "about:blank#idaten-webkit=<escaped http(s) URL>". The tab strip,
+// selection and closing keep working on the placeholder; only the content area
+// is covered by a WKWebView.
+inline constexpr char kWebKitTabRefPrefix[] = "idaten-webkit=";
+
+bool IsWebKitTabEnabled();
+
+// Returns the http(s) URL to show with WebKit, or an empty GURL if |contents|
+// is not a WebKit tab. Renderer-driven navigations (link / form / client
+// redirect transitions) are rejected.
+GURL GetWebKitTabTargetURL(content::WebContents* contents);
+
+}  // namespace idaten
