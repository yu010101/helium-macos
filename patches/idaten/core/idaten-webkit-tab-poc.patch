+// Sibling of ContentsWebView inside ContentsContainerView. When the active
+// WebContents is a WebKit tab, attaches that tab's WKWebView and becomes
+// visible; otherwise detaches and hides. One WKWebView per WebContents is kept
+// alive as WebContentsUserData (see the .mm file).
+class IdatenWebKitHostView : public views::NativeViewHost,
+                             public content::WebContentsObserver {
+  METADATA_HEADER(IdatenWebKitHostView, views::NativeViewHost)
+
+ public:
+  IdatenWebKitHostView();
+  IdatenWebKitHostView(const IdatenWebKitHostView&) = delete;
+  IdatenWebKitHostView& operator=(const IdatenWebKitHostView&) = delete;
+  ~IdatenWebKitHostView() override;
+
+  // Called whenever the ContentsWebView's WebContents changes (tab switch,
+  // split view change, nullptr on teardown).
+  void UpdateForActiveContents(content::WebContents* contents);
+
+  // views::View:
+  void AddedToWidget() override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  void HideAndDetach();
+};
