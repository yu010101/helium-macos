+    let editing = !!a && (a.isContentEditable || ((a.tagName === 'TEXTAREA' || a.tagName === 'INPUT') && (a.value || '').length > 0));
+    for (const el of [...live.edited]) {
+      if (!el.isConnected) { live.edited.delete(el); continue; }
+      try { if (dirty(el)) editing = true; } catch {}
+    }
