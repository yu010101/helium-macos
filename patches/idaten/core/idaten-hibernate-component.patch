+    if (el.isContentEditable) return (el.textContent || '').trim().length > 0;
+    if (el.tagName === 'TEXTAREA') return (el.value || '').length > 0;
+    if (el.tagName === 'SELECT') return [...el.options].some(o => o.selected !== o.defaultSelected);
